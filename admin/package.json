{
  "name": "lagom-admin",
  "private": true,
  "type": "module",
  "description": "The editor's JavaScript. Bundled into ../public/admin/app.js.",
  "scripts": {
    "build": "rm -rf ../public/admin/build && esbuild src/app.js --bundle --splitting --format=esm --minify --target=es2022 --outdir=../public/admin/build --entry-names=[name] --chunk-names=chunks/[name]-[hash]",
    "watch": "rm -rf ../public/admin/build && esbuild src/app.js --bundle --splitting --format=esm --sourcemap --target=es2022 --outdir=../public/admin/build --entry-names=[name] --chunk-names=chunks/[name]-[hash] --watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
