---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Hero illustration: black ink on transparent (see scripts/monocolor-heroes.mjs). */
	src: ImageMetadata;
	/** Rendered width in CSS px. The source is fetched at 2x for sharp lines on high-DPI screens. */
	width: number;
	/** Accessible name. Omit for purely decorative uses (the card title already names the post). */
	label?: string;
	class?: string;
}

const { src, width, label, class: className, ...rest } = Astro.props;
const art = await getImage({ src, width: width * 2, format: 'webp' });
---

<!--
	The illustration is only an alpha mask: the ink is painted with `var(--fg)`, so it follows the
	light/dark theme automatically. `role="img"` + aria-label gives it a name; without a label it is hidden.
-->
<div
	class:list={['art', className]}
	style={`--art:url("${art.src}");--ar:${src.width}/${src.height}`}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	{...rest}
>
</div>
