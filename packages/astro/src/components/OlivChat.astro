---
interface Props {
	/** Where questions are sent. Comes from the integration's `chat.endpoint` option. */
	endpoint: string;
}
const { endpoint } = Astro.props;

/** Who the assistant speaks for ("Ask me about Ada's work"). The integration's `chat.owner` option. */
const owner: string = import.meta.env.LAGOM_CHAT_OWNER || 'the author';
import sparkles from '../assets/icons/sparkles.svg?raw';
---

<aside class="oliv-chat" id="oliv-chat" aria-label="OLIV assistant" data-endpoint={endpoint} data-owner={owner}>
	<button class="oliv-launch" id="oliv-launch" type="button" aria-expanded="false" aria-controls="oliv-panel">
		<span class="oliv-stars" aria-hidden="true" set:html={sparkles} /><span>ask</span>
	</button>
	<section class="oliv-panel" id="oliv-panel" role="dialog" aria-labelledby="oliv-title" hidden>
		<header class="oliv-header">
			<div class="oliv-identity">
				<img class="oliv-avatar" src="/img/oliv-avatar.webp" alt="" width="48" height="48" loading="lazy" />
				<div>
					<h2 id="oliv-title">oliv</h2>
					<p>portfolio chatbot</p>
				</div>
			</div>
			<button class="oliv-close" id="oliv-close" type="button" aria-label="Close OLIV chat"><span aria-hidden="true">✕</span></button>
		</header>
		<div class="oliv-log" id="oliv-log" role="log" aria-label="Conversation" aria-live="polite">
			<div class="oliv-message oliv-message--bot">
				<img src="/img/oliv-avatar.webp" alt="" width="32" height="32" loading="lazy" />
				<p>I'm OLIV. Ask me about {owner}'s work, career, projects, or background.</p>
			</div>
		</div>
		<form class="oliv-form" id="oliv-form">
			<label class="sr-only" for="oliv-input">Ask OLIV a question</label>
			<textarea id="oliv-input" name="message" rows="2" maxlength="500" placeholder={`Ask about ${owner}...`} required></textarea>
			<button class="oliv-send" type="submit" id="oliv-send"><span aria-hidden="true">✧</span><span>send</span></button>
		</form>
	</section>
</aside>
