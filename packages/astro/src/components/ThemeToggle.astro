---
// Markup only. The behaviour lives in the inline script in <head> (Base.astro)
// so the theme is applied before first paint and survives view transitions.
// The label is static and the state is exposed through aria-pressed, which
// the script keeps in sync ("Dark theme: pressed" = dark is on).
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Dark theme" aria-pressed="false" title="Toggle light / dark theme">
	<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
	</svg>
	<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	</svg>
</button>
