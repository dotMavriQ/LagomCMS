---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { CMS_URL, type UploadedImage } from '../lib/lagom';
import '../styles/backdrop.css';

interface Props {
	/** A black-and-white photograph; the grade in backdrop.css colours it per theme. */
	photo?: ImageMetadata;
	/** A photo uploaded in the CMS, which takes the place of `photo`. It goes through the same
	 *  resizing pipeline; the only difference is that Astro fetches the original from the CMS. */
	uploaded?: UploadedImage;
	/** object-position, i.e. what stays in frame when a phone crops the sides. */
	position?: string;
	/** Scrim recipe: `home` pools shade behind the hero copy, `page` veils the whole picture for long, scrolling pages. */
	variant?: 'home' | 'page';
}

const { photo, uploaded, position, variant = 'home' } = Astro.props;

// The built-in photos are already black and white, which is what the colour grade in backdrop.css
// is built for. An upload may not be, so it is desaturated here; the contrast value repeats the
// one backdrop.css sets, because an inline filter replaces the stylesheet's rather than adding to it.
const source = uploaded ? { src: `${CMS_URL}${uploaded.src}`, width: uploaded.width, height: uploaded.height } : photo ? { src: photo } : undefined;
const uploadedStyle = uploaded ? 'filter: grayscale(1) contrast(1.24)' : undefined;
---

<!--
	A photograph, graded entirely in CSS, so one file serves both themes: the stacked layers below are a gradient map (see backdrop.css) whose only per-theme difference is
	colour. Purely decorative.
-->
<div class={`backdrop backdrop--${variant}`} aria-hidden="true" style={position ? `--photo-position: ${position}` : undefined}>
	{
		/* No photo at all is fine: the layers below still colour the page. See lib/backdrops.ts. */
		source && (
			<Picture
				{...source}
				style={uploadedStyle}
				alt=""
				class="backdrop__photo"
				formats={['avif', 'webp']}
				widths={[640, 1024, 1536, 2048, 2880]}
				sizes="100vw"
				quality={62}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				pictureAttributes={{ class: 'backdrop__picture' }}
			/>
		)
	}
	<div class="backdrop__gain"></div>
	<div class="backdrop__tint"></div>
	<div class="backdrop__floor"></div>
	<div class="backdrop__glow"></div>
	<div class="backdrop__scrim"></div>
	<div class="backdrop__grain"></div>
</div>
