{
    "name": "dotmavriq/lagomcms",
    "description": "An opinionated flat-file CMS: Markdown on disk, a disposable SQLite index, and an editor that stays out of the way.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "league/commonmark": "^2.7",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Lagom\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
